<?xml version="1.0" encoding="utf-8"?>
<!--
  mvrp-probe (PoC variant) — রিপোর্টের সাথে যা পাঠানো হবে।

  AndroidManifest.orphan.xml-এ ৯টা permission ছিল — ওটা তদন্তের যন্ত্র, সব
  অনাথ permission একসাথে পরীক্ষা করার জন্য। রিপোর্টে ওটা পাঠানো ভুল হতো:
  triager প্রথমেই জিজ্ঞেস করত "এতগুলো কেন?", আর অপ্রাসঙ্গিক ঘোষণাগুলো
  ব্যাখ্যা করতে গিয়ে আসল বিষয়টা চাপা পড়ত।

  এখানে ঠিক দুটো — রিপোর্টে যে দুটো component দেখানো হয়েছে, তাদেরটাই।

  এটা ছাড়া app-টা সম্পূর্ণ permission-বিহীন: একটাও আসল Android permission
  নেই, তাই "এই app যা পারে, যেকোনো app পারে" দাবিটা অক্ষত থাকে।
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cindrasec.mvrpprobe">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- Google Home-এর LockProximityReceiver এই নামে পাহারা দেওয়া।
         android:permission একটাই নাম নেয়; ওখানে দুটো `|` দিয়ে জোড়া, তাই
         পুরো স্ট্রিংটা একটা নাম হিসেবে পড়া হয় — আর সেই নামে কোনো
         permission কোনো ডিভাইসে সংজ্ঞায়িত নেই। -->
    <permission android:name="android.permission.BLUETOOTH|android.permission.BLUETOOTH_ADMIN"
                android:protectionLevel="normal" />
    <uses-permission android:name="android.permission.BLUETOOTH|android.permission.BLUETOOTH_ADMIN" />

    <!-- Google Home-এর FirstDockActivity এই নামে পাহারা দেওয়া। এই ডিভাইসে
         কোনো package এটা সংজ্ঞায়িত করে না। -->
    <permission android:name="com.google.android.settings.setup.dock.RUN_DOCK_SETUP"
                android:protectionLevel="normal" />
    <uses-permission android:name="com.google.android.settings.setup.dock.RUN_DOCK_SETUP" />

    <application
        android:label="mvrp-poc"
        android:allowBackup="false"
        android:hasCode="true">
        <activity
            android:name="com.cindrasec.mvrpprobe.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
