# .gitignore for the Bug Bounty Hunting Agent
#
# Raw evidence, session data, and credentials must NEVER leave the Pi.
# Only methodology, config templates, scripts, and reports (sanitized) go to git.

# Raw results and evidence — keep local, never push
results/*/01-assets/
results/*/02-surface/
results/*/03-candidates/
results/*/04-verified/*/evidence/
results/*/04-verified/*/raw/

# Secrets and tokens — HARD block
*.env
*.token
*.secret
*_token.txt
*cookies.txt
*session.txt

# Large tool outputs
*.gz
*.zip
*.tar

# Tool caches
.nuclei-config/
.config/amass/
.config/subfinder/

# Python cruft
__pycache__/
*.pyc
.venv/

# OS cruft
.DS_Store
Thumbs.db

# Orchestrator state is Pi-local (machine-specific paths, ephemeral)
results/**/.orchestrator-state.json

# Chain graph is Pi-local (rebuilt each hunt session)
results/**/chain-graph.json

# Candidate data is Pi-local (generated by nuclei scans on the Pi)
results/**/candidates.jsonl

# All raw JSONL scan/hit outputs under results/ are Pi-local
results/**/*.jsonl

# Raw OOB session logs under results/ are Pi-local
results/**/oob-*.log
results/**/oob-session*.log

# Raw recon logs
results/**/recon*.log

# Process ID / lock files
results/**/.recon.pid
results/**/*.pid

# Installer packages — never commit
*.deb

# Root-level temp/scratch files (scan outputs, diff snapshots, session state)
/enriched_mismatches.json
/expired_certs.txt
/final_ssl_mismatches.txt
/full_cert_details.txt
/live_https_hosts.txt
/ssl_mismatch_results.txt
/ssl_mismatches_parallel.txt
/third_party_certs.txt
/third_party_domains_ranked.txt
/tlsx_mismatches.txt
/tlsx_names.json
/unicef.org.txt
/verily_httpx_analysis.txt
/work-in-progress.diff
/pending-work.txt
/resume.cfg

# AppSheet staging recon outputs (raw scanner artifacts)
results/appsheet.com/staging-*.txt
results/appsheet.com/staging-github-hits.txt
results/appsheet.com/RECON-SUMMARY.md

# Raw nuclei / per-host scan output files
results/**/*03-candidates/nuclei-*.txt
results/**/03-vulns/

# Per-target raw recon subdirectories
results/*/recon/

# But DO commit (override the above for these paths)
!results/.gitkeep
!results/**/.gitkeep
!results/**/findings/*.md
!results/**/triage.md
!results/**/HUNT-LOG.md
!results/**/00-plan.md
results/**/recon.log
results/**/orchestrator.log

vt1/
*.vtkey
